# Copy to `.dev.vars` for local development (it is git-ignored).
# In production, set each value with `wrangler secret put <NAME>`. Never commit real values.
# Step-by-step instructions for the Google values: docs/setup-google.md

# Name, short name, logo, accent colour and features can also be set by an admin on
# /einstellungen; what's saved there wins over the values here.
# Display name of the orchestra. Optional; defaults to the name in the active config preset.
ORCHESTRA_NAME="Mein Orchester"
# Shorter name for the header on phones. Optional; defaults to ORCHESTRA_NAME.
# ORCHESTRA_SHORT_NAME="Orchester"
# Square logo for header, calendar and app icon: a file in static/ or an https link. Optional; default /logo.png.
# ORCHESTRA_LOGO="/mein-logo.svg"
# Accent colour as #rrggbb. The shades for the light and the dark scheme are derived from it,
# darkened or lightened just enough to stay readable; /status shows them. Optional.
# ORCHESTRA_ACCENT="#1d4ed8"
# Website and social media at the bottom of every page: a name and a web link each, separated
# by ";". Instagram, Facebook and YouTube get their icon. Optional; without it there are none.
# /einstellungen can set them too, and wins.
# ORCHESTRA_LINKS="Website https://example.org; Instagram https://www.instagram.com/mein_orchester/"
# Parts of the app this orchestra doesn't use, comma-separated. Their pages, menu entries and
# sheet tabs go away. Any of: leihmaterial, gema, anwesenheit, anmeldungen, wuensche, kalender, offline
# FEATURES_OFF="leihmaterial, gema"
# Parts that are off unless turned on here. "karten": concert tickets, reserved on the website
# and checked at the door (docs/tickets-plan.md).
# FEATURES_ON="karten"

# The app's own domain, e.g. "https://noten.example.org". With it, the workers.dev address
# redirects there, so sign-in, links and the installed app all use one address. Optional.
# APP_URL="https://noten.example.org"

# --- Google connection -----------------------------------------------------------
# Service-account key: the key file base64-encoded on one line (or its JSON as is).
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Drive folder ids (the part after /folders/ in the folder URL).
DRIVE_ARCHIVE_FOLDER_ID=""
# Current-programme folders ("Programm A-Orchester" …), several separated by commas. Optional.
# DRIVE_CURRENT_PROGRAM_FOLDER_ID="id-a,id-b"
# Weekly backup of the database (D1) as JSON, the last 8 kept. A folder only the admins can open:
# it holds members' names and email addresses. Written as the Drive account connected on /status,
# or as the service account (Editor, DRIVE_WRITE) in a shared drive. Optional.
# DRIVE_BACKUP_FOLDER_ID=""
# Calendar id of the rehearsal/concert calendar (Calendar settings → "Integrate calendar").
CALENDAR_ID=""
# Id of the Repertoire sheet (the part after /spreadsheets/d/ in its URL); shared as editor.
REPERTOIRE_SHEET_ID=""
# Mirror problem reports into Drive: comments on the files, status words in file names.
# Needs the service account as Editor of the archive folder. Default: read-only.
# DRIVE_WRITE="true"
# Let people with "termine.planen" add concerts and rehearsals to the calendar on /kalender.
# Needs the calendar shared with the service account with "Make changes to events". Default: read-only.
# CALENDAR_WRITE="true"

# YouTube Data API key (Google Cloud console → APIs → "YouTube Data API v3" → Credentials).
# Lets the piece editor suggest a duration from the Hörbeispiel's video. Optional, free.
# YOUTUBE_API_KEY=""

# --- Sign-in (docs/setup-google.md, step 9) ---------------------------------------
# Without GOOGLE_OAUTH_CLIENT_ID the app is open to everyone and read-only.
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# Random string, at least 32 characters, for signing session cookies.
# SESSION_SECRET=""
# Set to false to turn sign-in off again while keeping the values above. The app is then
# open to everyone and read-only, including /setup and /status. Default: true.
# FORCE_AUTH="true"
# Comma-separated emails that always have every right (the first admins).
# BOOTSTRAP_ADMINS="admin@example.org,second-admin@example.org"

# --- Notifications (#157) ------------------------------------------------------------
# Reminders on members' phones (unanswered rehearsals, rented music due) and a notice to the
# admins when the Google connection breaks. Make the pair with `node scripts/vapid-keys.mjs`;
# keep it, a new pair makes every device sign up again. Without it there are no notifications.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# --- Privacy notice (/datenschutz) and terms (/nutzungsbedingungen) -----------------
# Who is responsible for the app. LEGAL_NAME defaults to ORCHESTRA_NAME; LEGAL_ADDRESS is optional.
# LEGAL_NAME="Musterorchester e. V."
# LEGAL_ADDRESS="Musterstraße 1, 12345 Musterstadt"
# LEGAL_EMAIL="vorstand@example.org"
