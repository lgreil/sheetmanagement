# Copy to `.dev.vars` for local development (it is git-ignored).
# In production, set each value with `wrangler secret put <NAME>`. Never commit real values.
# Step-by-step instructions for the Google values: docs/setup-google.md

# Display name of the orchestra. Optional; defaults to the name in the active config preset.
ORCHESTRA_NAME="Mein Orchester"
# Shorter name for the header on phones. Optional; defaults to ORCHESTRA_NAME.
# ORCHESTRA_SHORT_NAME="Orchester"

# --- Google connection -----------------------------------------------------------
# Service-account key: the key file base64-encoded on one line (or its JSON as is).
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Drive folder ids (the part after /folders/ in the folder URL).
DRIVE_ARCHIVE_FOLDER_ID=""
# Current-programme folders ("Programm A-Orchester" …), several separated by commas. Optional.
# DRIVE_CURRENT_PROGRAM_FOLDER_ID="id-a,id-b"
# Calendar id of the rehearsal/concert calendar (Calendar settings → "Integrate calendar").
CALENDAR_ID=""
# Id of the Repertoire sheet (the part after /spreadsheets/d/ in its URL); shared as editor.
REPERTOIRE_SHEET_ID=""
# Mirror problem reports into Drive: comments on the files, status words in file names.
# Needs the service account as Editor of the archive folder. Default: read-only.
# DRIVE_WRITE="true"

# YouTube Data API key (Google Cloud console → APIs → "YouTube Data API v3" → Credentials).
# Lets the piece editor suggest a duration from the Hörbeispiel's video. Optional, free.
# YOUTUBE_API_KEY=""

# --- Sign-in (docs/setup-google.md, step 9) ---------------------------------------
# Without GOOGLE_OAUTH_CLIENT_ID the app is open to everyone and read-only.
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# Random string, at least 32 characters, for signing session cookies.
# SESSION_SECRET=""
# Set to false to turn sign-in off again while keeping the values above. The app is then
# open to everyone and read-only, including /setup and /status. Default: true.
# FORCE_AUTH="true"
# Comma-separated emails that always have every right (the first admins).
# BOOTSTRAP_ADMINS="admin@example.org,second-admin@example.org"

# --- Privacy notice (/datenschutz) and terms (/nutzungsbedingungen) -----------------
# Who is responsible for the app. LEGAL_NAME defaults to ORCHESTRA_NAME; LEGAL_ADDRESS is optional.
# LEGAL_NAME="Musterorchester e. V."
# LEGAL_ADDRESS="Musterstraße 1, 12345 Musterstadt"
# LEGAL_EMAIL="vorstand@example.org"
