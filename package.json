{
	"name": "sheetmanagement",
	"version": "0.5.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"description": "Sheet music and concert overview for orchestras, built on Google Drive, Google Calendar and Google Sheets.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite build && wrangler dev",
		"deploy": "vite build && wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"pdf-lib": "1.17.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.1"
	},
	"engines": {
		"node": ">=22.17"
	},
	"packageManager": "pnpm@10.7.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	}
}
